rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // TODO: "DEINE-FIREBASE-UID-HIER" ersetzen (siehe docs/SETUP.md)
    function isOwner() {
      return request.auth != null &&
             request.auth.uid == "DEINE-FIREBASE-UID-HIER";
    }

    // ── Geräte-Dokumente ─────────────────────────────────────────────────────
    match /devices/{deviceId} {
      allow read, write: if isOwner();

      match /locations/{locationId} {
        allow read: if isOwner();
        allow create: if isOwner() ||
          (request.auth != null &&
           request.auth.uid == deviceId &&
           request.resource.data.keys().hasOnly(["lat", "lng", "timestamp"]) &&
           request.resource.data.lat is number &&
           request.resource.data.lng is number &&
           request.resource.data.timestamp is number);
        allow update, delete: if isOwner();
      }

      match /captures/{captureId} {
        allow read: if isOwner();
        allow create: if isOwner() ||
          (request.auth != null && request.auth.uid == deviceId);
        allow update, delete: if isOwner();
      }
    }

    // ── Tagesberichte (nur lesen für Owner, schreiben nur Cloud Function) ────
    // Cloud Functions laufen als Admin und umgehen diese Regeln sowieso.
    // Die Regel hier schützt vor direktem Client-Schreiben.
    match /reports/{reportId} {
      allow read: if isOwner();
      allow write: if false;   // nur Cloud Function (Admin SDK) darf schreiben
    }

    // ── Owner-Gerät (Dashboard / Handy 1 – Web-Push-Token) ──────────────────
    match /owner/{docId} {
      allow read, write: if isOwner();
    }

    // ── Alles andere: kein Zugriff ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
